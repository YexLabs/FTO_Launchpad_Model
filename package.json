{
  "name": "fto-launchpad-model",
  "version": "1.0.0",
  "description": "**honeypotfinance** is a DEX project built on honeyswap v3",
  "scripts": {
    "lint:check": "eslint . --ext js,ts",
    "lint:fix": "eslint --fix . --ext js,ts",
    "prettier:check": "prettier --check '**/*.{ts,js,json,sol}'",
    "prettier:fix": "prettier --write '**/*.{ts,js,json,sol}'",
    "solhint:check": "solhint 'contracts/**/*.sol'",
    "test": "mocha",
    "compile": "hardhat compile",
    "compile:force": "hardhat compile --force",
    "clean": "rimraf ./build/",
    "deploy": "npm run compile && ts-node --script-mode scripts/deploy-factory.ts",
    "prepare": "husky",
    "docgen": "hardhat docgen",
    "predocgen": "rm -rf cache && npm run compile:force && rm -rf docs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YexLabs/FTO_Launchpad_Model"
  },
  "keywords": [],
  "files": [
    "/contracts/**/*.sol",
    "/build/**/*"
  ],
  "author": "YexLabs",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/YexLabs/FTO_Launchpad_Model/issues"
  },
  "homepage": "https://github.com/YexLabs/FTO_Launchpad_Model#readme",
  "devDependencies": {
    "@ethersproject/abi": "^5.4.7",
    "@ethersproject/providers": "^5.4.7",
    "@nomicfoundation/hardhat-chai-matchers": "^1.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^2.0.0",
    "@nomiclabs/hardhat-ethers": "^2.0.0",
    "@nomiclabs/hardhat-etherscan": "^3.0.0",
    "@openzeppelin/contracts-upgradeable": "^4.9.3",
    "@typechain/ethers-v5": "^10.1.0",
    "@typechain/hardhat": "^6.1.2",
    "@types/chai": "^4.3.4",
    "@types/mocha": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "chai": "^4.2.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "ethereum-waffle": "^4.0.10",
    "ethereumjs-util": "^7.1.5",
    "ethers": "^5.4.7",
    "hardhat": "^2.14.1",
    "hardhat-gas-reporter": "^1.0.8",
    "husky": "^9.1.4",
    "mocha": "^10.2.0",
    "prettier": "^3.3.3",
    "prettier-plugin-solidity": "^1.3.1",
    "rimraf": "^4.4.1",
    "solc": "^0.8.16",
    "solhint": "^5.0.2",
    "solidity-coverage": "^0.8.2",
    "solidity-docgen": "^0.6.0-beta.36",
    "ts-node": "^10.9.1",
    "typechain": "^8.1.0",
    "typescript": "^5.0.2"
  },
  "dependencies": {
    "@chainlink/contracts": "^0.8.0",
    "@openzeppelin/contracts": "^4.9.0",
    "dotenv": "^16.4.5"
  }
}
